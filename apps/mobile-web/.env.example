# Copy to .env.local (git-ignored). Only EXPO_PUBLIC_* values reach the client bundle:
# never put service-role keys, provider secrets or webhook secrets here.

# Data adapter: "mock" (InMemoryAdapter, deterministic demo data, OTP 123456) or "supabase".
# Unset = supabase when URL + anon key are present, otherwise mock.
EXPO_PUBLIC_DATA=mock

# Supabase project (anon key only; RLS protects every table).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Basemap (src/platform/map/style.ts).
# Unset = OpenFreeMap "positron" (free, keyless): https://tiles.openfreemap.org/styles/positron
# Labels follow the UI language (name:<lang>, falling back to the local name). Dark mode
# re-tints the light style at runtime unless EXPO_PUBLIC_MAP_STYLE_URL_DARK names a dedicated
# dark style (used as-is). Any MapLibre style URL works (OpenFreeMap liberty/bright, MapTiler, Stadia).
EXPO_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_MAP_STYLE_URL_DARK=

# 1 = offline canvas: bundled no-network style (tinted land, dotted lattice, vignette; labels are
# app overlays, so no tiles/glyphs/sprites are fetched). Required for the claude.ai Artifact build
# (its CSP blocks external hosts). Unset = online, except in automated browsers
# (navigator.webdriver, i.e. Playwright e2e), which always use the offline canvas. 0 forces online.
EXPO_PUBLIC_MAP_OFFLINE=

# Stage-1 wake-up geofence for check-in (native only). Off for the MVP stores build.
EXPO_PUBLIC_FEATURE_GEOFENCE=false

# Mock adapter: artificial latency per call (ms) to preview loading states.
EXPO_PUBLIC_MOCK_LATENCY_MS=0

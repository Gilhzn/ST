# Copy to .env.local (git-ignored). Only EXPO_PUBLIC_* values reach the client bundle:
# never put service-role keys, provider secrets or webhook secrets here.

# Data adapter: "mock" (InMemoryAdapter, deterministic demo data, OTP 123456) or "supabase".
# Unset = supabase when URL + anon key are present, otherwise mock.
EXPO_PUBLIC_DATA=mock

# Supabase project (anon key only; RLS protects every table).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# MapLibre vector style URL(s). Unset = bundled blank style (no network; used by e2e).
# e.g. https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_MAP_STYLE_URL_DARK=

# Stage-1 wake-up geofence for check-in (native only). Off for the MVP stores build.
EXPO_PUBLIC_FEATURE_GEOFENCE=false

# Mock adapter: artificial latency per call (ms) to preview loading states.
EXPO_PUBLIC_MOCK_LATENCY_MS=0
